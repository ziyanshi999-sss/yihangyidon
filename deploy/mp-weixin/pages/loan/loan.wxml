<view class="loan-container data-v-4eb099c3"><view class="page-header data-v-4eb099c3"><text class="header-title data-v-4eb099c3">贷款服务</text></view><view wx:if="{{a}}" class="loan-overview data-v-4eb099c3"><view class="overview-content data-v-4eb099c3"><text class="overview-label data-v-4eb099c3">您有一笔贷款</text><text class="overview-amount data-v-4eb099c3">¥{{b}}</text><text class="overview-status data-v-4eb099c3">{{c}}</text><view class="loan-details data-v-4eb099c3"><text class="detail-item data-v-4eb099c3">贷款类型: {{d}}</text><text class="detail-item data-v-4eb099c3">贷款期限: {{e}} 个月</text><text class="detail-item data-v-4eb099c3">贷款利率: {{f}}%</text><text class="detail-item data-v-4eb099c3">已还期数: {{g}}/{{h}}</text><text class="detail-item data-v-4eb099c3">下次还款日: {{i}}</text><text class="detail-item data-v-4eb099c3">下次还款金额: ¥{{j}}</text></view><view class="overview-actions data-v-4eb099c3"><button class="action-btn primary data-v-4eb099c3" bindtap="{{k}}">立即还款</button><button class="action-btn secondary data-v-4eb099c3" bindtap="{{l}}">查看详情</button></view></view></view><view wx:else class="no-loan data-v-4eb099c3"><text class="no-loan-icon data-v-4eb099c3">💸</text><text class="no-loan-text data-v-4eb099c3">您当前没有贷款记录</text><button class="apply-btn data-v-4eb099c3" bindtap="{{m}}">立即申请</button></view><view class="loan-products data-v-4eb099c3"><view class="section-header data-v-4eb099c3"><text class="section-title data-v-4eb099c3">热门贷款产品</text><text class="view-all data-v-4eb099c3" bindtap="{{n}}">查看全部</text></view><view class="products-list data-v-4eb099c3"><view wx:for="{{o}}" wx:for-item="product" wx:key="g" class="product-card data-v-4eb099c3" bindtap="{{product.h}}"><view class="product-header data-v-4eb099c3"><text class="product-title data-v-4eb099c3">{{product.a}}</text><text class="product-rate data-v-4eb099c3">{{product.b}}%</text><text class="rate-label data-v-4eb099c3">年利率</text></view><view class="product-info data-v-4eb099c3"><text class="info-item data-v-4eb099c3">{{product.c}}</text><text class="info-item data-v-4eb099c3">{{product.d}}</text><text class="info-item data-v-4eb099c3">{{product.e}}</text></view><button class="apply-product-btn data-v-4eb099c3" catchtap="{{product.f}}">立即申请</button></view></view></view><view class="loan-tools data-v-4eb099c3"><view class="section-header data-v-4eb099c3"><text class="section-title data-v-4eb099c3">贷款工具</text></view><view class="tools-grid data-v-4eb099c3"><view class="tool-item data-v-4eb099c3" bindtap="{{p}}"><view class="tool-icon data-v-4eb099c3">🧮</view><text class="tool-text data-v-4eb099c3">贷款计算器</text></view><view class="tool-item data-v-4eb099c3" bindtap="{{q}}"><view class="tool-icon data-v-4eb099c3">📊</view><text class="tool-text data-v-4eb099c3">利率查询</text></view><view class="tool-item data-v-4eb099c3" bindtap="{{r}}"><view class="tool-icon data-v-4eb099c3">📝</view><text class="tool-text data-v-4eb099c3">还款计划</text></view><view class="tool-item data-v-4eb099c3" bindtap="{{s}}"><view class="tool-icon data-v-4eb099c3">❓</view><text class="tool-text data-v-4eb099c3">常见问题</text></view></view></view><view class="loan-news data-v-4eb099c3"><view class="section-header data-v-4eb099c3"><text class="section-title data-v-4eb099c3">贷款资讯</text><text class="view-all data-v-4eb099c3" bindtap="{{t}}">查看全部</text></view><view class="news-list data-v-4eb099c3"><view wx:for="{{v}}" wx:for-item="news" wx:key="c" class="news-item data-v-4eb099c3" bindtap="{{news.d}}"><text class="news-title data-v-4eb099c3">{{news.a}}</text><text class="news-date data-v-4eb099c3">{{news.b}}</text></view></view></view></view>